managed implementation in class ZBP_R_NWPRODUCTS unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_NWPRODUCTS alias Products
persistent table ZNW_PRODUCTS
extensible
draft table ZNWPRODUCTS_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( mandatory : create )
   ProductID;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt;

  field ( readonly : update )
   ProductID;


  create;
  update;
  delete;

  static action LoadFromIFlow;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZNW_PRODUCTS corresponding extensible
  {
    ProductID = PRODUCT_ID;
    ProductName = PRODUCT_NAME;
    UnitPrice = UNIT_PRICE;
    CategoryID = CATEGORY_ID;
    QtyPerUnit = QTY_PER_UNIT;
    Discontinued = DISCONTINUED;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

}